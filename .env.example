# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_BILLING_ACCOUNT=your-billing-account-id

# Budget Configuration
MONTHLY_BUDGET_USD=100
ALERT_EMAIL=your-email@example.com

# GitHub Configuration (for Workload Identity Federation)
GITHUB_ORG=your-github-org
GITHUB_REPO=mlops-in-a-box

# Vertex AI Configuration
VERTEX_ENDPOINT_NAME=mlops-endpoint
VERTEX_MIN_REPLICAS=1
VERTEX_MAX_REPLICAS=1
VERTEX_MACHINE_TYPE=n1-standard-2

# Auto-shutdown Configuration
IDLE_TIMEOUT_HOURS=2

